PORT=3000
MONGO_URL=mongodb://127.0.0.1:27017/ztcg
# Gere um segredo novo, aleatório, com pelo menos 32 caracteres.
SECRET=substitua-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
# Vazio permite somente a origem do próprio servidor para partidas.
# Em produção, informe a origem pública exata (sem barra no final).
ALLOWED_ORIGINS=
# Segredo independente para /ops/maintenance e /ops/metrics (Bearer).
CRON_SECRET=
# Opcional: destino dos alertas operacionais em JSON; nunca exposto ao navegador.
ALERT_WEBHOOK_URL=
# Usado apenas pelo script/workflow de backup, não pelo jogo.
BACKUP_ENCRYPTION_KEY=

# Recuperação de senha (Resend)
RESEND_API_KEY=
RESET_EMAIL_FROM=
PUBLIC_APP_URL=https://ztcg.vercel.app

# Gmail SMTP: senha de app, nunca a senha normal da conta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
